# Copy to deploy/.env; use a long randomly generated value. Never commit .env.
FREETRAIN_OPERATOR_SECRET=replace-with-a-random-operator-key
FREETRAIN_IMAGE=freetrain:prototype
FREETRAIN_SITE=localhost
FREETRAIN_TLS=internal
FREETRAIN_BIND=127.0.0.1
FREETRAIN_HTTP_PORT=8080
FREETRAIN_HTTPS_PORT=8443
FREETRAIN_CHECKPOINT_INTERVAL=00:00:30
# For a public host: SITE=game.example.org, TLS=operator@example.org,
# BIND=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443; see doc/web-deployment.md.
