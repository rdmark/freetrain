{
  "nodeModulesDir": "auto",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "imports": {
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@7.3.1",
    "@playwright/test": "npm:@playwright/test@1.64.1",
    "ajv": "npm:ajv@8.20.0",
    "json-schema-to-typescript": "npm:json-schema-to-typescript@16.0.0",
    "svelte": "npm:svelte@5.57.2",
    "svelte-check": "npm:svelte-check@4.7.7",
    "typescript": "npm:typescript@6.0.3",
    "vite": "npm:vite@8.3.4"
  },
  "tasks": {
    "dev": "deno run -A npm:vite@8.3.4 --host 127.0.0.1",
    "build": "deno task check && deno run -A npm:vite@8.3.4 build",
    "preview": "deno run -A npm:vite@8.3.4 preview --host 127.0.0.1",
    "generate:contracts": "deno run -A scripts/generate-contracts.mjs",
    "check:generated": "deno run -A scripts/generate-contracts.mjs --check",
    "check": "deno task check:generated && deno task check:content && deno run -A npm:svelte-check@4.7.7 --tsconfig ./tsconfig.json",
    "test": "deno test -A --no-check tests/contracts.test.mjs tests/shell-model.test.ts tests/remote-client.test.ts tests/map.test.ts",
    "install:browser": "deno run -A npm:@playwright/test@1.64.1 install chromium",
    "test:browser": "deno task build && deno run -A npm:@playwright/test@1.64.1 test",
    "import:content": "deno run --allow-run=python3 scripts/import-content.ts",
    "check:content": "deno run --allow-run=python3 scripts/import-content.ts --check"
  }
}
